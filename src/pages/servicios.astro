---
/**
 * servicios.astro — Services page
 * All service data comes from src/data/services.ts
 * TODO: Edit service content in src/data/services.ts
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/sections/CTABanner.astro';
import { SERVICES, SERVICE_CATEGORIES } from '@data/services';
import { CTA } from '@data/site';

// Group services by category
const grouped = Object.entries(SERVICE_CATEGORIES).map(([key, label]) => ({
  key,
  label,
  items: SERVICES.filter((s) => s.category === key),
}));
---

<BaseLayout
  title="Servicios — The Ascend"
  description="Desarrollo web, SEO local, chatbots IA, automatizaciones y más. Servicios de transformación digital para pequeñas empresas en Francia, España y Perú."
>
  <!-- Hero -->
  <section class="page-hero section">
    <div class="container page-hero__inner">
      <div class="page-hero__content">
        <span class="section-label reveal">Servicios</span>
        <h1 class="page-hero__title reveal reveal--delay-1">
          Todo lo que necesitas<br />para <span class="text-gradient">crecer online.</span>
        </h1>
        <p class="page-hero__subtitle reveal reveal--delay-2">
          No vendemos herramientas. Vendemos resultados.
          Cada servicio está diseñado pensando en el crecimiento real de tu negocio.
        </p>
      </div>
    </div>
  </section>

  <!-- Services by category -->
  {grouped.map((group) => group.items.length > 0 && (
    <section class="services-category section" id={group.key} aria-labelledby={`cat-${group.key}`}>
      <div class="container">
        <h2 class="services-category__title reveal" id={`cat-${group.key}`}>
          {group.label}
        </h2>
        <div class="services-full-grid">
          {group.items.map((service, i) => (
            <article
              class={`service-full-card reveal reveal--delay-${(i % 3) + 1}`}
              id={service.id}
              aria-labelledby={`service-name-${service.id}`}
            >
              <div class="service-full-card__header">
                <div class="service-full-card__icon" aria-hidden="true">
                  {service.icon.charAt(0)}
                </div>
                <div>
                  <h3 class="service-full-card__name" id={`service-name-${service.id}`}>
                    {service.name}
                  </h3>
                  <p class="service-full-card__tagline">{service.tagline}</p>
                </div>
              </div>

              <p class="service-full-card__desc">{service.description}</p>

              <div class="service-full-card__features">
                <h4 class="service-full-card__features-title">Incluye:</h4>
                <ul class="service-full-card__features-list">
                  {service.features.map((feat) => (
                    <li class="service-full-card__feature">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      {feat}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="service-full-card__footer">
                <div class="service-full-card__meta">
                  <div class="service-full-card__duration">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/>
                      <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    {service.duration}
                  </div>
                  <div class="service-full-card__for">
                    Ideal para: {service.idealFor.join(', ')}
                  </div>
                </div>
                <a href="/contacto" class="btn btn--primary btn--sm">
                  {CTA.quote}
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTABanner />
</BaseLayout>

<style>
  /* Page Hero */
  .page-hero {
    padding-top: calc(4rem + var(--space-16));
    border-bottom: 1px solid var(--color-border);
  }

  .page-hero__inner {
    max-width: 760px;
  }

  .page-hero__title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.05em;
    line-height: 1.0;
    margin-bottom: var(--space-6);
  }

  .page-hero__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Category */
  .services-category__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-xs);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  /* Full grid */
  .services-full-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  /* Full card */
  .service-full-card {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition:
      border-color var(--duration-normal) var(--ease-default),
      transform var(--duration-normal) var(--ease-spring);
  }

  .service-full-card:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
  }

  .service-full-card__header {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .service-full-card__icon {
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--color-primary-glow);
    border: 1px solid var(--color-primary-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-bold);
    color: var(--color-primary-light);
    flex-shrink: 0;
  }

  .service-full-card__name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .service-full-card__tagline {
    font-size: var(--text-sm);
    color: var(--color-primary-light);
    font-weight: var(--weight-medium);
    margin-top: var(--space-1);
  }

  .service-full-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .service-full-card__features {
    flex: 1;
  }

  .service-full-card__features-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }

  .service-full-card__features-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .service-full-card__feature {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .service-full-card__feature svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .service-full-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .service-full-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .service-full-card__duration {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }

  .service-full-card__for {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-4);
  }

  @media (max-width: 768px) {
    .services-full-grid {
      grid-template-columns: 1fr;
    }

    .page-hero__title {
      font-size: var(--text-4xl);
    }
  }
</style>

---
/**
 * mathias.astro - Founder page for Mathias Hinostroza
 * TODO: Add photos to /public/mathias/ as foto_mathias1.jpg, foto_mathias2.jpg, etc.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Mathias Hinostroza — Fundador · The Ascend"
  description="Conoce a Mathias Hinostroza, fundador de The Ascend. Desarrollador web apasionado por la IA y la ciberseguridad."
>

  <!-- ═══ HERO ═══ -->
  <section class="founder-hero" aria-label="Presentacion del fundador">
    <div class="founder-hero__bg" aria-hidden="true">
      <div class="founder-hero__orb founder-hero__orb--1"></div>
      <div class="founder-hero__orb founder-hero__orb--2"></div>
      <div class="founder-hero__dots"></div>
    </div>
    <div class="container founder-hero__inner">
      <div class="founder-hero__text">
        <div class="founder-hero__eyebrow reveal">
          <span class="founder-hero__eyebrow-dot" aria-hidden="true"></span>
          Fundador · The Ascend
        </div>
        <h1 class="founder-hero__name reveal reveal--delay-1">
          Mathias<br />
          <span class="text-gradient">Hinostroza.</span>
        </h1>
        <p class="founder-hero__tagline reveal reveal--delay-2">
          Desarrollador web, apasionado por la IA y la ciberseguridad.
          Cree The Ascend para democratizar la transformacion digital.
        </p>
        <div class="founder-hero__meta reveal reveal--delay-3">
          <span class="founder-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Grenoble, Francia
          </span>
          <span class="founder-meta-chip">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
            BUT Informatique · Grenoble Alpes
          </span>
        </div>
        <div class="founder-hero__ctas reveal reveal--delay-4">
          <a href="/contacto" class="btn btn--primary btn--lg btn--shimmer">
            <span>Trabajemos juntos</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="mailto:info@the-ascend.store" class="btn btn--secondary btn--lg">info@the-ascend.store</a>
        </div>
      </div>
      <div class="founder-hero__portrait reveal reveal--delay-2">
        <div class="founder-portrait__frame">
          <div class="founder-portrait__img-wrap" id="pw1">
            <img src="/mathias/foto_mathias1.jpg" alt="Mathias Hinostroza" class="founder-portrait__img" onerror="document.getElementById('pw1').classList.add('ph')" loading="eager" />
            <div class="founder-portrait__placeholder" aria-hidden="true">
              <span class="founder-portrait__placeholder-icon">&#9650;</span>
              <span>foto_mathias1</span>
            </div>
          </div>
          <div class="founder-portrait__ring" aria-hidden="true"></div>
          <div class="founder-portrait__badge" aria-hidden="true">
            <span class="founder-portrait__badge-dot"></span>
            <span>Disponible</span>
          </div>
        </div>
      </div>
    </div>
    <div class="hero__scroll" aria-hidden="true"><div class="hero__scroll-line"></div></div>
  </section>

  <!-- ═══ STATS STRIP ═══ -->
  <section class="founder-strip section">
    <div class="container">
      <div class="founder-strip__grid">
        <div class="founder-strip__item reveal">
          <span class="founder-strip__number">+<span class="js-counter" data-target="40">0</span></span>
          <span class="founder-strip__label">Proyectos entregados</span>
        </div>
        <div class="founder-strip__divider" aria-hidden="true"></div>
        <div class="founder-strip__item reveal reveal--delay-1">
          <span class="founder-strip__number js-counter" data-target="3">0</span>
          <span class="founder-strip__label">Países · FR · ES · PE</span>
        </div>
        <div class="founder-strip__divider" aria-hidden="true"></div>
        <div class="founder-strip__item reveal reveal--delay-2">
          <span class="founder-strip__number js-counter" data-target="21">0</span>
          <span class="founder-strip__label">Años de edad</span>
        </div>
        <div class="founder-strip__divider" aria-hidden="true"></div>
        <div class="founder-strip__item reveal reveal--delay-3">
          <span class="founder-strip__number founder-strip__number--inf">∞</span>
          <span class="founder-strip__label">Curiosidad</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ STORY ═══ -->
  <section class="founder-story section" aria-labelledby="story-title">
    <div class="container">
      <div class="founder-story__layout">
        <div class="founder-story__photo reveal reveal--left">
          <div class="founder-story__photo-frame" id="sf2">
            <img src="/mathias/foto_mathias2.jpg" alt="Mathias trabajando" class="founder-story__img" onerror="document.getElementById('sf2').classList.add('ph')" loading="lazy" />
            <div class="founder-story__photo-placeholder" aria-hidden="true"><span>foto_mathias2</span></div>
          </div>
          <div class="founder-story__float-card reveal reveal--delay-2">
            <div class="founder-story__float-icon">&#127891;</div>
            <div>
              <div class="founder-story__float-title">BUT Informatique</div>
              <div class="founder-story__float-sub">IUT2 · Grenoble Alpes · Media 14,3/20</div>
            </div>
          </div>
        </div>
        <div class="founder-story__text">
          <span class="section-label reveal">Mi historia</span>
          <h2 class="section-title reveal reveal--delay-1" id="story-title">
            Naci en Lima.<br />
            <span class="text-gradient">Construyo desde Grenoble.</span>
          </h2>
          <div class="founder-story__body">
            <p class="reveal reveal--delay-2">Soy peruano, creci con la tecnologia como herramienta y como juego. A los 20 anos cruce el Atlantico para estudiar informatica en Francia, y lo que empezo como un proyecto personal se convirtio en <strong>The Ascend</strong>: una agencia real, con clientes reales, en tres paises.</p>
            <p class="reveal reveal--delay-3">Estudio <strong>BUT Informatique</strong> en la Universite Grenoble Alpes, donde combino teoria con proyectos practicos: chatbots con IA, maquinas virtuales Linux y proyectos colaborativos. Paralelamente contribuyo como desarrollador front-end en <strong>YapayHub</strong> y construyo <em>Unrespiro</em>, una app movil para jovenes.</p>
            <p class="reveal reveal--delay-4">Lo que me mueve es simple: quiero que la tecnologia sea accesible para el restaurante de barrio, la clinica familiar, el abogado independiente.</p>
          </div>
          <div class="founder-story__langs reveal reveal--delay-4">
            <span class="lang-badge">&#127477;&#127466; Espanol nativo</span>
            <span class="lang-badge">&#127467;&#127479; Francais B1+</span>
            <span class="lang-badge">&#127468;&#127463; English B1/B2</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SKILLS ═══ -->
  <section class="founder-skills section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Stack tecnico</span>
        <h2 class="section-title" id="skills-title">Con que<br /><span class="text-gradient">trabajo.</span></h2>
        <p class="section-subtitle">Tecnologias que uso a diario, aprendo activamente y aplico en proyectos reales.</p>
      </div>
      <div class="skills-categories">
        <div class="skills-cat reveal">
          <div class="skills-cat__header">
            <span class="skills-cat__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg></span>
            <span class="skills-cat__title">Desarrollo</span>
          </div>
          <div class="skills-pills">
            <span class="skill-pill">Python</span><span class="skill-pill">JavaScript</span><span class="skill-pill">Java</span><span class="skill-pill">C</span><span class="skill-pill">HTML/CSS</span><span class="skill-pill">PHP</span><span class="skill-pill">SQL</span><span class="skill-pill">Astro</span><span class="skill-pill">React</span>
          </div>
        </div>
        <div class="skills-cat reveal reveal--delay-1">
          <div class="skills-cat__header">
            <span class="skills-cat__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
            <span class="skills-cat__title">Sistemas y Redes</span>
          </div>
          <div class="skills-pills">
            <span class="skill-pill">Linux</span><span class="skill-pill">SSH</span><span class="skill-pill">Administration</span><span class="skill-pill">Redes Wi-Fi</span><span class="skill-pill">Virtualizacion</span>
          </div>
        </div>
        <div class="skills-cat reveal reveal--delay-2">
          <div class="skills-cat__header">
            <span class="skills-cat__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
            <span class="skills-cat__title">Ciberseguridad</span>
          </div>
          <div class="skills-pills">
            <span class="skill-pill skill-pill--accent">Pentest</span><span class="skill-pill skill-pill--accent">SIEM</span><span class="skill-pill skill-pill--accent">Hacking etico</span><span class="skill-pill skill-pill--accent">Deteccion amenazas</span><span class="skill-pill skill-pill--accent">Respuesta incidentes</span>
          </div>
        </div>
        <div class="skills-cat reveal reveal--delay-3">
          <div class="skills-cat__header">
            <span class="skills-cat__icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></span>
            <span class="skills-cat__title">Herramientas</span>
          </div>
          <div class="skills-pills">
            <span class="skill-pill">Git / GitHub</span><span class="skill-pill">VS Code</span><span class="skill-pill">AI Tools</span><span class="skill-pill">Figma</span><span class="skill-pill">Gestion de proyectos</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ TIMELINE ═══ -->
  <section class="founder-timeline section" aria-labelledby="timeline-title">
    <div class="container container--narrow">
      <div class="section-header reveal text-center">
        <span class="section-label">Trayectoria</span>
        <h2 class="section-title" id="timeline-title">El camino<br /><span class="text-gradient">hasta aqui.</span></h2>
      </div>
      <div class="timeline">
        <div class="timeline__item reveal">
          <div class="timeline__marker"><div class="timeline__dot timeline__dot--active"></div><div class="timeline__line"></div></div>
          <div class="timeline__card">
            <div class="timeline__card-header"><span class="timeline__date">2025 - Ahora</span><span class="timeline__badge timeline__badge--active">Activo</span></div>
            <h3 class="timeline__title">Desarrollador Front-end · YapayHub</h3>
            <p class="timeline__desc">Contribucion a la UI/UX de una plataforma de gestion SaaS. Foco en experiencia de usuario y presentacion visual.</p>
            <a href="https://yapayhub.com" target="_blank" rel="noopener noreferrer" class="timeline__link">yapayhub.com</a>
          </div>
        </div>
        <div class="timeline__item reveal">
          <div class="timeline__marker"><div class="timeline__dot"></div><div class="timeline__line"></div></div>
          <div class="timeline__card">
            <div class="timeline__card-header"><span class="timeline__date">2025 - Ahora</span><span class="timeline__badge">Formacion</span></div>
            <h3 class="timeline__title">BUT Informatique - IUT2 Grenoble Alpes</h3>
            <p class="timeline__desc">1a ano. Proyectos SAE: chatbot con IA/NLP, VM Linux completa, proyecto colaborativo MEGA SEA. Media: 14,3/20.</p>
          </div>
        </div>
        <div class="timeline__item reveal">
          <div class="timeline__marker"><div class="timeline__dot"></div><div class="timeline__line"></div></div>
          <div class="timeline__card">
            <div class="timeline__card-header"><span class="timeline__date">Desde 2024</span><span class="timeline__badge">Fundador</span></div>
            <h3 class="timeline__title">Fundador y Desarrollador - The Ascend</h3>
            <p class="timeline__desc">Cree y dirijo una agencia de transformacion digital: web, branding y automatizacion para negocios en Francia, Espana y Peru.</p>
            <a href="https://the-ascend.store" target="_blank" rel="noopener noreferrer" class="timeline__link">the-ascend.store</a>
          </div>
        </div>
        <div class="timeline__item reveal">
          <div class="timeline__marker"><div class="timeline__dot"></div><div class="timeline__line"></div></div>
          <div class="timeline__card">
            <div class="timeline__card-header"><span class="timeline__date">2022 - 2025</span><span class="timeline__badge">Formacion</span></div>
            <h3 class="timeline__title">Baccalaureat - Lycee Paul Le Rolland, Drancy</h3>
            <p class="timeline__desc">Base academica. Primeros proyectos digitales personales y primeros pasos en programacion autodidacta.</p>
          </div>
        </div>
        <div class="timeline__item reveal">
          <div class="timeline__marker"><div class="timeline__dot"></div><div class="timeline__line"></div></div>
          <div class="timeline__card">
            <div class="timeline__card-header"><span class="timeline__date">2022 · Lima, Peru</span><span class="timeline__badge">Experiencia</span></div>
            <h3 class="timeline__title">Asistente IT · Municipalidad y experiencia comercial</h3>
            <p class="timeline__desc">Proyecto IT municipal con protocolos de seguridad. Atencion al cliente y gestion de stocks en comercio local.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ CERTIFICATIONS ═══ -->
  <section class="founder-certs section" aria-labelledby="certs-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Certificaciones</span>
        <h2 class="section-title" id="certs-title">Formado por<br /><span class="text-gradient">los mejores.</span></h2>
        <p class="section-subtitle">Certificaciones obtenidas fuera del aula — porque aprender nunca para.</p>
      </div>

      <!-- Big featured cert -->
      <div class="cert-hero reveal">
        <div class="cert-hero__glow" aria-hidden="true"></div>
        <div class="cert-hero__left">
          <div class="cert-hero__badge">
            <span class="cert-hero__badge-icon">🎓</span>
          </div>
          <div class="cert-hero__meta">
            <span class="cert-hero__institution">HarvardX</span>
            <span class="cert-hero__year">2024</span>
          </div>
        </div>
        <div class="cert-hero__content">
          <h3 class="cert-hero__name">CS50's Introduction to AI<br /><span class="text-gradient">with Python</span></h3>
          <p class="cert-hero__desc">Algoritmos de búsqueda, redes neuronales, NLP y machine learning aplicados con Python. Uno de los cursos más exigentes de Harvard Online.</p>
        </div>
        <div class="cert-hero__verified" aria-label="Certificado verificado">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Verificado</span>
        </div>
      </div>

      <!-- Grid of remaining certs -->
      <div class="certs-grid-v2">
        <div class="cert-card-v2 reveal">
          <div class="cert-card-v2__top">
            <span class="cert-card-v2__icon">📊</span>
            <span class="cert-card-v2__year">2024</span>
          </div>
          <div class="cert-card-v2__institution">HarvardX</div>
          <h3 class="cert-card-v2__name">Introduction to Data Science</h3>
          <div class="cert-card-v2__footer">
            <div class="cert-card-v2__check">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Completado
            </div>
          </div>
        </div>

        <div class="cert-card-v2 reveal reveal--delay-1">
          <div class="cert-card-v2__top">
            <span class="cert-card-v2__icon">🛡️</span>
            <span class="cert-card-v2__year">2025</span>
          </div>
          <div class="cert-card-v2__institution">Google · Coursera</div>
          <h3 class="cert-card-v2__name">Ciberseguridad: SIEM, detección y respuesta a incidentes</h3>
          <div class="cert-card-v2__footer">
            <div class="cert-card-v2__check">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Completado
            </div>
          </div>
        </div>

        <div class="cert-card-v2 reveal reveal--delay-2">
          <div class="cert-card-v2__top">
            <span class="cert-card-v2__icon">⚡</span>
            <span class="cert-card-v2__year">2024–25</span>
          </div>
          <div class="cert-card-v2__institution">MasterMind</div>
          <h3 class="cert-card-v2__name">Pack Ciberseguridad & Desarrollo: hacking ético, Wi-Fi, Git</h3>
          <div class="cert-card-v2__footer">
            <div class="cert-card-v2__check">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Completado
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ GALLERY ═══ -->
  <section class="founder-gallery section" aria-labelledby="gallery-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Galeria</span>
        <h2 class="section-title" id="gallery-title">Momentos<br /><span class="text-gradient">reales.</span></h2>
      </div>
      <div class="gallery-grid">
        <div class="gallery-item gallery-item--tall reveal" id="g3"><img src="/mathias/foto_mathias3.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g3').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias3</span></div></div>
        <div class="gallery-item reveal reveal--delay-1" id="g4"><img src="/mathias/foto_mathias4.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g4').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias4</span></div></div>
        <div class="gallery-item reveal reveal--delay-2" id="g5"><img src="/mathias/foto_mathias5.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g5').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias5</span></div></div>
        <div class="gallery-item reveal reveal--delay-1" id="g6"><img src="/mathias/foto_mathias6.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g6').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias6</span></div></div>
        <div class="gallery-item gallery-item--tall reveal reveal--delay-2" id="g7"><img src="/mathias/foto_mathias7.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g7').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias7</span></div></div>
        <div class="gallery-item reveal reveal--delay-3" id="g8"><img src="/mathias/foto_mathias8.jpg" alt="Mathias" class="gallery-item__img" onerror="document.getElementById('g8').classList.add('ph')" loading="lazy" /><div class="gallery-item__placeholder" aria-hidden="true"><span class="gph-icon">&#9650;</span><span class="gph-name">foto_mathias8</span></div></div>
      </div>
    </div>
  </section>

  <!-- ═══ PROJECTS ═══ -->
  <section class="founder-projects section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Proyectos personales</span>
        <h2 class="section-title" id="projects-title">Lo que<br /><span class="text-gradient">construyo.</span></h2>
      </div>
      <div class="projects-grid">

        <!-- Featured: Unrespiro -->
        <div class="project-card project-card--featured reveal">
          <div class="project-card__number" aria-hidden="true">01</div>
          <div class="project-card__inner">
            <div class="project-card__top">
              <div class="project-card__status">
                <span class="project-card__status-dot"></span>
                En desarrollo
              </div>
              <div class="project-card__tag">App móvil</div>
            </div>
            <h3 class="project-card__name">Unrespiro</h3>
            <p class="project-card__desc">App para ayudar a jóvenes a organizarse mejor en su día a día. Interfaz rápida, recordatorios cortos, diseño orientado al usuario. Mi proyecto principal de producto propio.</p>
            <div class="project-card__tech">
              <span>Mobile</span><span>UI/UX</span><span>Productividad</span>
            </div>
          </div>
          <div class="project-card__bar" aria-hidden="true"></div>
        </div>

        <!-- Chatbot IA -->
        <div class="project-card reveal reveal--delay-1">
          <div class="project-card__number" aria-hidden="true">02</div>
          <div class="project-card__inner">
            <div class="project-card__top">
              <div class="project-card__tag">IA / NLP · BUT</div>
            </div>
            <h3 class="project-card__name">Chatbot universitario</h3>
            <p class="project-card__desc">Agente conversacional desarrollado en equipo aplicando IA y procesamiento del lenguaje natural en el BUT Informatique.</p>

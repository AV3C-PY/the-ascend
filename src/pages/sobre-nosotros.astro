---
/**
 * sobre-nosotros.astro — About page
 * TODO: Update company story, values, and team info here
 * TODO: Add real team photos in /public/team/ if desired
 */

import BaseLayout from '@layouts/BaseLayout.astro';
import CTABanner from '@components/sections/CTABanner.astro';
import { SITE, CTA } from '@data/site';
---

<BaseLayout
  title="Sobre Nosotros — The Ascend"
  description="Conoce The Ascend: nuestra historia, filosofía y por qué ayudamos a pequeñas empresas a transformarse digitalmente en Francia, España y Perú."
>
  <!-- Hero -->
  <section class="page-hero section">
    <div class="container">
      <div class="about-hero">
        <div class="about-hero__text">
          <span class="section-label reveal" data-i18n="about.sectionLabel">Sobre Nosotros</span>
          <!-- TODO: Update headline -->
          <h1 class="page-hero__title reveal reveal--delay-1" data-i18n="about.title">
            No somos una agencia.<br />
            <span class="text-gradient">Somos tu equipo digital.</span>
          </h1>
          <!-- TODO: Update company description -->
          <p class="page-hero__subtitle reveal reveal--delay-2" data-i18n="about.subtitle">
            The Ascend nació de una convicción simple: las pequeñas empresas merecen
            el mismo nivel de calidad digital que las grandes marcas.
            Sin presupuestos astronómicos. Sin procesos interminables.
            Sin tecnicismos innecesarios.
          </p>
        </div>
        <div class="about-hero__visual reveal reveal--delay-3" aria-hidden="true">
          <div class="about-hero__card">
            <div class="about-hero__card-icon">▲</div>
            <div class="about-hero__card-text">
              <span class="about-hero__card-name">The Ascend</span>
              <span class="about-hero__card-role">Transformación Digital</span>
            </div>
          </div>
          <div class="about-hero__stats">
            <div class="about-hero__stat">
              <span class="about-hero__stat-n">🇫🇷</span>
              <span data-i18n="about.markets.items.0.country">Francia</span>
            </div>
            <div class="about-hero__stat">
              <span class="about-hero__stat-n">🇪🇸</span>
              <span data-i18n="about.markets.items.1.country">España</span>
            </div>
            <div class="about-hero__stat">
              <span class="about-hero__stat-n">🇵🇪</span>
              <span data-i18n="about.markets.items.2.country">Perú</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="about-philosophy section" aria-labelledby="philosophy-title">
    <div class="container container--narrow">
      <h2 class="section-title text-center reveal" id="philosophy-title" data-i18n="about.philosophy.title">Nuestra filosofía</h2>

      <div class="philosophy-grid">
        {[0, 1, 2].map((i) => (
          <div class={`philosophy-item reveal reveal--delay-${i + 1}`}>
            <span class="philosophy-item__label" data-i18n={`about.philosophy.items.${i}.label`}></span>
            <h3 class="philosophy-item__title" data-i18n={`about.philosophy.items.${i}.title`}></h3>
            <p class="philosophy-item__body" data-i18n={`about.philosophy.items.${i}.body`}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="about-values section" aria-labelledby="values-title">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label" data-i18n="about.values.label">Valores</span>
        <h2 class="section-title" id="values-title" data-i18n="about.values.title">Lo que nos define.</h2>
      </div>

      <div class="values-grid">
        {[
          { icon: "✦" },
          { icon: "◈" },
          { icon: "◉" },
          { icon: "⬡" },
          { icon: "◇" },
          { icon: "△" },
        ].map((value, i) => (
          <div class={`value-item reveal reveal--delay-${(i % 3) + 1}`}>
            <span class="value-item__icon" aria-hidden="true">{value.icon}</span>
            <h3 class="value-item__title" data-i18n={`about.values.items.${i}.title`}></h3>
            <p class="value-item__desc" data-i18n={`about.values.items.${i}.description`}></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Markets -->
  <section class="about-markets section" aria-labelledby="markets-title">
    <div class="container container--narrow">
      <div class="section-header reveal">
        <h2 class="section-title" id="markets-title" data-i18n="about.markets.title">Donde estamos.</h2>
        <p class="section-subtitle" data-i18n="about.markets.subtitle">
          Operamos en tres mercados con características y necesidades diferentes.
          Conocemos las particularidades de cada uno.
        </p>
      </div>

      <div class="markets-grid">
        {[
          { flag: "🇫🇷", focus: [0, 1, 2] },
          { flag: "🇪🇸", focus: [0, 1, 2] },
          { flag: "🇵🇪", focus: [0, 1, 2] },
        ].map((market, i) => (
          <div class={`market-item reveal reveal--delay-${i + 1}`}>
            <h3 class="market-item__country">
              <span aria-hidden="true">{market.flag}</span>{' '}
              <span data-i18n={`about.markets.items.${i}.country`}></span>
            </h3>
            <p class="market-item__desc" data-i18n={`about.markets.items.${i}.description`}></p>
            <ul class="market-item__focus">
              {market.focus.map((itemIndex) => (
                <li class="market-item__focus-item" data-i18n={`about.markets.items.${i}.focus.${itemIndex}`}></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    title="¿Quieres trabajar con nosotros?"
    subtitle="Cuéntanos sobre tu negocio. Estaremos encantados de conocer tu proyecto."
  />
</BaseLayout>

<style>
  .page-hero {
    padding-top: calc(4rem + var(--space-16));
    border-bottom: 1px solid var(--color-border);
  }

  /* About hero */
  .about-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }

  .about-hero__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .page-hero__title {
    font-size: var(--text-5xl);
    font-weight: var(--weight-extrabold);
    letter-spacing: -0.05em;
    line-height: 1.0;
  }

  .page-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Visual card */
  .about-hero__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .about-hero__card {
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-primary-border);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    gap: var(--space-4);
    box-shadow: var(--shadow-glow);
  }

  .about-hero__card-icon {
    font-size: 2rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .about-hero__card-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .about-hero__card-name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .about-hero__card-role {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .about-hero__stats {
    display: flex;
    gap: var(--space-3);
  }

  .about-hero__stat {
    flex: 1;
    padding: var(--space-4);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .about-hero__stat-n {
    font-size: 1.5rem;
  }

  /* Philosophy */
  .philosophy-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-10);
  }

  .philosophy-item {
    padding: var(--space-8);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition:
      border-color var(--duration-normal) var(--ease-default),
      box-shadow   var(--duration-normal) var(--ease-default);
  }

  .philosophy-item:hover {
    border-color: var(--color-primary-border);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .philosophy-item__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .philosophy-item__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .philosophy-item__body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 560px;
  }

  /* Values */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .value-item {
    padding: var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition:
      border-color var(--duration-normal) var(--ease-default),
      transform    var(--duration-slow)   var(--ease-spring),
      box-shadow   var(--duration-slow)   var(--ease-default);
    will-change: transform;
  }

  .value-item:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .value-item__icon {
    font-size: 1.5rem;
    color: var(--color-primary-light);
  }

  .value-item__title {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .value-item__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Markets */
  .markets-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .market-item {
    /* Generous internal padding — premium, breathable feel */
    padding: var(--space-10) var(--space-8);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      border-color var(--duration-slow) var(--ease-spring),
      transform var(--duration-slow) var(--ease-spring),
      box-shadow var(--duration-slow) var(--ease-spring);
  }

  .market-item:hover {
    border-color: var(--color-primary-border);
    transform: translateY(-5px);
    box-shadow:
      var(--shadow-lg),
      0 0 40px -8px rgba(99, 102, 241, 0.18);
  }

  .market-item__country {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .market-item__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    font-family: var(--font-body);
  }

  .market-item__focus {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    /* Push focus list to bottom of the card */
    margin-top: auto;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .market-item__focus-item {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    padding-left: var(--space-4);
    position: relative;
    letter-spacing: 0.01em;
  }

  .market-item__focus-item::before {
    content: "·";
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-size: 1.1em;
  }

  /* Shared */
  .section-header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  .section-title {
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .section-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .text-center { text-align: center; }

  @media (max-width: 900px) {
    .about-hero {
      grid-template-columns: 1fr;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .markets-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .page-hero__title {
      font-size: var(--text-4xl);
    }
  }

  @media (max-width: 600px) {
    .values-grid {
      grid-template-columns: 1fr;
    }

    .markets-grid {
      grid-template-columns: 1fr;
    }

    /* Reduce padding on small phones while keeping the premium feel */
    .market-item {
      padding: var(--space-8) var(--space-6);
    }
  }

  @media (max-width: 400px) {
    .market-item {
      padding: var(--space-6) var(--space-5);
    }
  }
</style>

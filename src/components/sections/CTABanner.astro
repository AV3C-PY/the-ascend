---
/**
 * CTABanner.astro
 * Full-width call-to-action banner.
 * Appears at the bottom of most pages.
 * TODO: Update CTA text, headline, and button labels here or in src/data/site.ts
 */

import { CTA, SITE } from '@data/site';

interface Props {
  title?: string;
  subtitle?: string;
  ctaPrimary?: string;
  ctaSecondary?: string;
  ctaSecondaryHref?: string;
  i18nTitle?: string;
  i18nSubtitle?: string;
}

const {
  title = "¿Listo para transformar tu negocio?",
  subtitle = "Cuéntanos sobre tu proyecto. La consulta inicial es gratuita y sin compromiso. Respondemos en menos de 24 horas.",
  ctaPrimary = CTA.primary,
  ctaSecondary = CTA.whatsapp,
  ctaSecondaryHref = `https://wa.me/${SITE.whatsapp}`,
  i18nTitle = "cta.bannerTitle",
  i18nSubtitle = "cta.bannerSubtitle",
} = Astro.props;
---

<section class="cta-banner section" aria-labelledby="cta-banner-title">
  <div class="container">
    <div class="cta-banner__inner reveal">
      <!-- Background effects -->
      <div class="cta-banner__bg" aria-hidden="true">
        <div class="cta-banner__glow cta-banner__glow--1"></div>
        <div class="cta-banner__glow cta-banner__glow--2"></div>
      </div>

      <!-- Content -->
      <div class="cta-banner__content">
        <h2 class="cta-banner__title" id="cta-banner-title" data-i18n={i18nTitle}>
          {title}
        </h2>
        <p class="cta-banner__subtitle" data-i18n={i18nSubtitle}>{subtitle}</p>

        <div class="cta-banner__actions">
          <a href="/contacto" class="btn btn--primary btn--lg btn--shimmer" data-i18n="cta.primary">
            {ctaPrimary}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href={ctaSecondaryHref}
            class="cta-banner__whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span data-i18n="cta.whatsapp">{ctaSecondary}</span>
          </a>
        </div>

        <!-- Trust indicators -->
        <div class="cta-banner__trust">
          <span class="cta-banner__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-i18n="cta.trust.0">Consulta gratuita</span>
          </span>
          <span class="cta-banner__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-i18n="cta.trust.1">Respuesta en &lt;24h</span>
          </span>
          <span class="cta-banner__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-i18n="cta.trust.2">Sin compromiso</span>
          </span>
          <span class="cta-banner__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span data-i18n="cta.trust.3">Pago solo cuando estés convencido</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-banner__inner {
    position: relative;
    padding: var(--space-16) var(--space-12);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-primary-border);
    background: rgba(99, 102, 241, 0.05);
    overflow: hidden;
    text-align: center;
  }

  /* Background glows */
  .cta-banner__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .cta-banner__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
  }

  .cta-banner__glow--1 {
    width: 400px;
    height: 400px;
    top: -100px;
    left: 10%;
    background: radial-gradient(circle, rgba(99,102,241,0.2) 0%, transparent 70%);
  }

  .cta-banner__glow--2 {
    width: 300px;
    height: 300px;
    bottom: -80px;
    right: 10%;
    background: radial-gradient(circle, rgba(167,139,250,0.15) 0%, transparent 70%);
  }

  /* Content */
  .cta-banner__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .cta-banner__title {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    max-width: 600px;
  }

  .cta-banner__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 520px;
    line-height: var(--leading-relaxed);
  }

  .cta-banner__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-banner__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-success);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid rgba(34, 197, 94, 0.25);
    background: rgba(34, 197, 94, 0.08);
    transition:
      background-color var(--duration-fast) var(--ease-default),
      border-color var(--duration-fast) var(--ease-default);
  }

  .cta-banner__whatsapp:hover {
    background: rgba(34, 197, 94, 0.12);
    border-color: rgba(34, 197, 94, 0.4);
  }

  /* Trust */
  .cta-banner__trust {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta-banner__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cta-banner__trust-item svg {
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .cta-banner__inner {
      padding: var(--space-10) var(--space-6);
    }

    .cta-banner__title {
      font-size: var(--text-3xl);
    }

    .cta-banner__actions {
      flex-direction: column;
      width: 100%;
    }

    .cta-banner__actions .btn,
    .cta-banner__whatsapp {
      width: 100%;
      justify-content: center;
    }

    .cta-banner__trust {
      gap: var(--space-3);
    }
  }
</style>

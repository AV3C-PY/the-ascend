---
/**
 * PortfolioTeaser.astro
 * Home page portfolio preview (featured projects only).
 * Full portfolio is at /portfolio.
 * TODO: Edit portfolio items in src/data/portfolio.ts
 * TODO: Add real project images to /public/portfolio/
 */

import { PORTFOLIO } from '@data/portfolio';

const featured = PORTFOLIO.filter((p) => p.featured).slice(0, 3);
---

<section class="portfolio-teaser section" aria-labelledby="portfolio-teaser-title">
  <div class="container">
    <!-- Header -->
    <div class="section-header reveal" style="margin-bottom: var(--space-12)">
      <!-- TODO: Update portfolio text in src/i18n/es.ts and fr.ts (portfolio.*) -->
      <span class="section-label" data-i18n="portfolio.sectionLabel">Portfolio</span>
      <h2 class="section-title" id="portfolio-teaser-title" data-i18n="portfolio.title">
        Proyectos que hablan<br />por sí solos.
      </h2>
      <p class="section-subtitle" data-i18n="portfolio.subtitle">
        Cada proyecto es un negocio transformado. Resultados reales, medibles y documentados.
      </p>
    </div>

    <!-- Portfolio grid -->
    <div class="portfolio-teaser__grid">
      {featured.map((project, i) => (
        <article
          class={`portfolio-card reveal reveal--delay-${i + 1} ${i === 0 ? 'portfolio-card--featured' : ''}`}
          aria-label={project.title}
        >
          <!-- Image placeholder -->
          <!-- TODO: Replace with real project image -->
          <div class="portfolio-card__image">
            <div class="portfolio-card__image-placeholder" aria-hidden="true">
              <span class="portfolio-card__image-letter">
                {project.title.charAt(0)}
              </span>
              <span class="portfolio-card__image-industry">
                {project.industry}
              </span>
            </div>
            <div class="portfolio-card__overlay">
              <a href={`/portfolio#${project.id}`} class="portfolio-card__overlay-btn" data-i18n="portfolio.seeCase">
                Ver caso de estudio
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

          <!-- Info -->
          <div class="portfolio-card__info">
            <div class="portfolio-card__meta">
              <span class="portfolio-card__industry">{project.industry}</span>
              <span class="portfolio-card__location">{project.location}</span>
            </div>
            <h3 class="portfolio-card__title">{project.title}</h3>
            <p class="portfolio-card__desc">{project.description}</p>

            <!-- Results -->
            <ul class="portfolio-card__results">
              {project.results.slice(0, 2).map((result) => (
                <li class="portfolio-card__result">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 7l-8.5 8.5-5-5L1 18"/>
                    <path d="M16 7h6v6"/>
                  </svg>
                  {result}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <!-- Footer CTA -->
    <div class="portfolio-teaser__footer reveal">
      <a href="/portfolio" class="btn btn--secondary btn--lg">
        Ver todos los proyectos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  /* Grid — increased top spacing for visual rhythm */
  .portfolio-teaser__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  /* Increase space between header (title+subtitle) and cards */
  .portfolio-teaser .section-header {
    margin-bottom: var(--space-12);
  }

  /* Card */
  .portfolio-card {
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    overflow: hidden;
    transition:
      border-color var(--duration-normal) var(--ease-default),
      transform var(--duration-normal) var(--ease-spring);
    display: flex;
    flex-direction: column;
  }

  .portfolio-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-4px);
  }

  /* Image area */
  .portfolio-card__image {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .portfolio-card__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-surface-2) 0%, var(--color-surface) 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }

  .portfolio-card__image-letter {
    font-family: var(--font-display);
    font-size: var(--text-6xl);
    font-weight: var(--weight-extrabold);
    color: rgba(255,255,255,0.05);
    line-height: 1;
  }

  .portfolio-card__image-industry {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* Hover overlay */
  .portfolio-card__overlay {
    position: absolute;
    inset: 0;
    background: rgba(9, 9, 11, 0.7);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--duration-normal) var(--ease-default);
  }

  .portfolio-card:hover .portfolio-card__overlay {
    opacity: 1;
  }

  .portfolio-card__overlay-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.15);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-md);
    backdrop-filter: blur(8px);
    transition: background-color var(--duration-fast) var(--ease-default);
  }

  .portfolio-card__overlay-btn:hover {
    background: rgba(255,255,255,0.15);
  }

  /* Info */
  .portfolio-card__info {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .portfolio-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .portfolio-card__industry {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    background: var(--color-primary-glow);
    border: 1px solid var(--color-primary-border);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-full);
  }

  .portfolio-card__location {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .portfolio-card__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .portfolio-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Results */
  .portfolio-card__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: auto;
  }

  .portfolio-card__result {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-success);
    font-weight: var(--weight-medium);
  }

  /* Footer */
  .portfolio-teaser__footer {
    display: flex;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .portfolio-teaser__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .portfolio-teaser__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

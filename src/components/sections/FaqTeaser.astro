---
/**
 * FaqTeaser.astro
 * Home page FAQ teaser — shows 3 most common questions.
 * Full FAQ is at /faq.
 * TODO: Edit FAQ content in src/data/faq.ts
 */

import { FAQ } from '@data/faq';

// Show first 4 questions on home
const teaserFaqs = FAQ.slice(0, 4);
---

<section class="faq-teaser section" aria-labelledby="faq-teaser-title">
  <div class="container">
    <div class="faq-teaser__inner">
      <!-- Header -->
      <div class="faq-teaser__header reveal">
        <span class="section-label">FAQ</span>
        <!-- TODO: Update FAQ section headline -->
        <h2 class="section-title" id="faq-teaser-title">
          Preguntas frecuentes.
        </h2>
        <p class="section-subtitle">
          Respuestas claras a las dudas más comunes. Sin tecnicismos.
        </p>
        <a href="/faq" class="btn btn--secondary">
          Ver todas las preguntas
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- FAQ accordion -->
      <div class="faq-teaser__list">
        {teaserFaqs.map((item, i) => (
          <details class={`faq-item reveal reveal--delay-${i + 1}`} id={`faq-${item.id}`}>
            <summary class="faq-item__summary">
              <span class="faq-item__question">{item.question}</span>
              <span class="faq-item__icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <div class="faq-item__answer">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .faq-teaser__inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: var(--space-20);
    align-items: start;
  }

  .faq-teaser__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    align-items: flex-start;
    position: sticky;
    top: calc(4rem + var(--space-8));
  }

  .faq-teaser__header .section-title {
    text-align: left;
  }

  .faq-teaser__header .section-subtitle {
    text-align: left;
  }

  /* FAQ list */
  .faq-teaser__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Item */
  .faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    overflow: hidden;
    transition: border-color var(--duration-fast) var(--ease-default);
  }

  .faq-item[open] {
    border-color: var(--color-primary-border);
  }

  .faq-item__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color var(--duration-fast) var(--ease-default);
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__summary:hover {
    background-color: rgba(255, 255, 255, 0.02);
  }

  .faq-item__question {
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    line-height: var(--leading-snug);
  }

  .faq-item__icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform var(--duration-normal) var(--ease-spring);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
    color: var(--color-primary);
  }

  .faq-item__answer {
    padding: 0 var(--space-6) var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .faq-item__answer p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    padding-top: var(--space-4);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .faq-teaser__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .faq-teaser__header {
      position: static;
    }
  }
</style>

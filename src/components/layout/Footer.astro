---
/**
 * Footer.astro
 * Site footer with navigation, social links, and legal links.
 * TODO: Update social links in src/data/site.ts
 * TODO: Add/remove footer links as needed
 */

import { SITE, CTA } from '@data/site';
import { SERVICES } from '@data/services';

const currentYear = new Date().getFullYear();

// TODO: Update footer nav links when adding new pages
const FOOTER_NAV = {
  empresa: [
    { href: '/sobre-nosotros', label: 'Sobre Nosotros',       i18nKey: 'footer.links.about' },
    { href: '/proceso',        label: 'Nuestro Proceso',      i18nKey: 'footer.links.process' },
    { href: '/portfolio',      label: 'Portfolio',            i18nKey: 'footer.links.portfolio' },
    { href: '/contacto',       label: 'Contacto',             i18nKey: 'footer.links.contact' },
  ],
  servicios: SERVICES.slice(0, 6).map((s) => ({
    href: `/servicios#${s.id}`,
    label: s.name,
    i18nKey: `services.items.${s.id}.name`,
  })),
  legal: [
    { href: '/privacidad', label: 'Política de Privacidad', i18nKey: 'footer.links.privacy' },
    { href: '/terminos',   label: 'Términos de Servicio',   i18nKey: 'footer.links.terms' },
  ],
};
---

<footer class="footer">
  <!-- Top section -->
  <div class="footer__top">
    <div class="container footer__top-inner">
      <!-- Brand column -->
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <span class="footer__logo-icon">▲</span>
          <span class="footer__logo-text">{SITE.name}</span>
        </a>
        <p class="footer__tagline" data-i18n="footer.tagline">
          Transformación digital para negocios que quieren crecer.
        </p>
        <!-- Social links -->
        <!-- TODO: Update social URLs in src/data/site.ts -->
        <div class="footer__social">
          <a
            href={SITE.instagramUrl}
            class="footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de The Ascend"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
            @{SITE.instagram}
          </a>
          <a
            href={`mailto:${SITE.email}`}
            class="footer__social-link"
            aria-label="Email de The Ascend"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
            {SITE.email}
          </a>
        </div>
      </div>

      <!-- Nav columns -->
      <div class="footer__nav">
        <div class="footer__col">
          <h3 class="footer__col-title" data-i18n="footer.columnsTitle.company">Empresa</h3>
          <ul class="footer__col-list">
            {FOOTER_NAV.empresa.map((link) => (
              <li>
                <a href={link.href} class="footer__col-link" data-i18n={link.i18nKey}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="footer__col">
          <h3 class="footer__col-title" data-i18n="footer.columnsTitle.services">Servicios</h3>
          <ul class="footer__col-list">
            {FOOTER_NAV.servicios.map((link) => (
              <li>
                <a href={link.href} class="footer__col-link" data-i18n={link.i18nKey}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="footer__col">
          <h3 class="footer__col-title">¿Listo para empezar?</h3>
          <p class="footer__col-text">
            Cuéntanos sobre tu proyecto. Sin compromisos, sin presiones.
          </p>
          <a href="/contacto" class="btn btn--primary btn--sm footer__cta">
            {CTA.primary}
          </a>
          <!-- TODO: Update WhatsApp number in src/data/site.ts -->
          <a
            href={`https://wa.me/${SITE.whatsapp}`}
            class="footer__whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            {CTA.whatsapp}
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copy" data-i18n="footer.markets">
        © {currentYear} {SITE.name}. Todos los derechos reservados.
      </p>
      <div class="footer__legal">
        {FOOTER_NAV.legal.map((link) => (
          <a href={link.href} class="footer__legal-link" data-i18n={link.i18nKey}>{link.label}</a>
        ))}
      </div>
      <p class="footer__markets" data-i18n="footer.markets">
        🇫🇷 Francia · 🇪🇸 España · 🇵🇪 Perú
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg-elevated);
    margin-top: auto;
  }

  /* Top section */
  .footer__top {
    padding-block: var(--space-16) var(--space-12);
  }

  .footer__top-inner {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--space-16);
  }

  /* Brand */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    text-decoration: none;
  }

  .footer__logo-icon {
    font-size: 1.125rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .footer__logo-text {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 260px;
    margin-bottom: var(--space-6);
  }

  .footer__social {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__social-link:hover {
    color: var(--color-text-primary);
  }

  /* Nav columns */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .footer__col-title {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .footer__col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__col-link {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__col-link:hover {
    color: var(--color-text-primary);
  }

  .footer__col-text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .footer__cta {
    display: inline-flex;
    margin-bottom: var(--space-3);
  }

  .footer__whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-success);
    transition: opacity var(--duration-fast) var(--ease-default);
  }

  .footer__whatsapp:hover {
    opacity: 0.8;
  }

  /* Bottom bar */
  .footer__bottom {
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .footer__legal {
    display: flex;
    gap: var(--space-4);
  }

  .footer__legal-link {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-default);
  }

  .footer__legal-link:hover {
    color: var(--color-text-secondary);
  }

  .footer__markets {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .footer__top-inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .footer__nav {
      grid-template-columns: 1fr;
    }

    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
